# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.log

# Saved scans (contain personal software inventory - never commit)
scans/*
!scans/.gitkeep

# Legacy directories (may still exist during migration)
output/
!output/.gitkeep
profiles/
!profiles/.gitkeep

# Config files containing personal software/browser lists
configs/
output/configs/
scan_results.json
